<UserControl x:Class="TabExample.Views.Table2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:behaviors="clr-namespace:TabExample.Behaviors">

    <Border Margin="12"
            Padding="8"
            Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="8">

        <DataGrid Style="{StaticResource ModernDataGrid}"
                  AutoGeneratingColumn="DataGrid_AutoGeneratingColumn"
                  ItemsSource="{Binding Items}"
                  behaviors:DataGridRowDoubleClickBehavior.Command=
                      "{Binding RowDoubleClickCommand}"/>

    </Border>
</UserControl>