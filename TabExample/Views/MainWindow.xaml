<Window x:Class="TabExample.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TabExample.ViewModels"
        xmlns:views="clr-namespace:TabExample.Views"
        Title="Multiple Tables"
        Height="450"
        Width="750"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <DataTemplate DataType="{x:Type vm:Table1ViewModel}">
            <views:Table1View />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:Table2ViewModel}">
            <views:Table2View />
        </DataTemplate>

        <!-- TODO: Step 6:Add a DataTemplate for the third table (Table3ViewModel) -->
        <DataTemplate DataType="{x:Type vm:Table3ViewModel}">
            <views:Table3View />
        </DataTemplate>

        <!-- Colored tab headers -->
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="2,0,2,0"/>
            <Setter Property="Background" Value="#455A64"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,4"
                                CornerRadius="6,6,0,0"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                ContentSource="Header"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Table1: Blue -->
                            <DataTrigger Binding="{Binding TabTitle}"
                                         Value="Table1">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="#1976D2"/>
                            </DataTrigger>

                            <!-- Table2: Green -->
                            <DataTrigger Binding="{Binding TabTitle}"
                                         Value="Table2">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="#388E3C"/>
                            </DataTrigger>

                            <!-- TODO: Step 7: Add a colour for Tab 3 -->
                            <!-- Table3: Purple -->
                            <DataTrigger Binding="{Binding TabTitle}"
                                         Value="Table3">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="#9C27B0"/>
                            </DataTrigger>

                            <!-- Selected tab: gold underline -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="BorderBrush"
                                        Value="#FFC107"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>

                            <!-- Hover effect -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Opacity"
                                        Value="0.85"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </Window.Resources>

    <Grid Margin="10">
        <TabControl ItemsSource="{Binding Tabs}"
                    SelectedIndex="{Binding SelectedTabIndex}">

            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding TabTitle}"/>
                </DataTemplate>
            </TabControl.ItemTemplate>

        </TabControl>
    </Grid>
</Window>