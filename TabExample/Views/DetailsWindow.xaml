<Window x:Class="TabExample.Views.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Details"
        Height="220"
        Width="350"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText"
                   Grid.Row="0"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Margin="0,0,0,15" />

        <Button Grid.Row="1"
                Content="Close"
                Width="80"
                HorizontalAlignment="Right"
                IsCancel="True" />
    </Grid>
</Window>
